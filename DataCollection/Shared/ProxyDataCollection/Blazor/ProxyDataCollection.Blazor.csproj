<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <None Remove=".sa3licx" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include=".sa3licx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="C1.DataCollection">
      <Version>10.0.20262.6</Version>
    </PackageReference>
    <PackageReference Include="C1.DataCollection.BindingList">
      <Version>10.0.20262.6</Version>
    </PackageReference>
    <PackageReference Include="C1.DataCollection.Serialization">
      <Version>10.0.20262.6</Version>
    </PackageReference>
    <PackageReference Include="C1.DataCollection.SignalR.Client">
      <Version>10.0.20262.6</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="C1.Blazor.Core" Version="10.0.20261.126" />
    <PackageReference Include="C1.Blazor.Grid" Version="10.0.20261.126" />
    <PackageReference Include="C1.Blazor.Input" Version="10.0.20261.126" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\ProxyDataCollection.Shared.csproj" />
  </ItemGroup>
</Project>