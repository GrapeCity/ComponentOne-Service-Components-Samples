<Page x:Class="C1DataCollection101.Sorting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:C1DataCollection101"
      mc:Ignorable="d" 
      WindowTitle="Sorting"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static local:Resources.SortingLabel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Button Content="{x:Static local:Resources.SortLabel}" Click="OnSortClicked" HorizontalAlignment="Left" Margin="4"/>
        <DataGrid x:Name="grid" 
                  AutoGenerateColumns="False" 
                  HeadersVisibility="All" 
                  CanUserAddRows="True" 
                  CanUserSortColumns="True" 
                  CanUserDeleteRows="True" 
                  CanUserReorderColumns="True" AddingNewItem="OnAddingNewItem" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Title}" Header="Title"/>
                <DataGridTextColumn Binding="{Binding ChannelTitle}" Header="Channel"/>
