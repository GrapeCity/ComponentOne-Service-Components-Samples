<Page x:Class="C1DataCollection101.OnDemand"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:C1DataCollection101"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OnDemand">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static local:Resources.ScrollDownMessage}" Margin="4"/>
        <DataGrid x:Name="grid" IsReadOnly="True" AutoGenerateColumns="False" Grid.Row="1" ScrollViewer.ScrollChanged="OnScrollChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Title}" Header="Title"/>
                <DataGridTextColumn Binding="{Binding ChannelTitle}" Header="Channel"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Page>
