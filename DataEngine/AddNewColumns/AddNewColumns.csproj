<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DisableSA3>true</DisableSA3>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="C1.AdoNet.OData" Version="1.0.20262.*" />
    <PackageReference Include="C1.DataEngine">
      <Version>10.0.20262.421</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="C1.DataEngine" />
    <Using Include="C1.AdoNet.OData" />
    <Using Include="System.Data.Common" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include=".sa3licx" />
  </ItemGroup>
</Project>